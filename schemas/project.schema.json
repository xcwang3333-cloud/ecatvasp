{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecatvasp.local/schema/project-v3.json",
  "title": "ECatVASP Project Header Schema v3",
  "description": "Human-readable project.yaml header contract; full domain metadata is stored in .workbench/project.sqlite.",
  "type": "object",
  "required": ["schema_version", "project_id", "name", "slug", "database"],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "description": "Permanent UUIDv7 project identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "const": ".workbench/project.sqlite"
    }
  },
  "additionalProperties": true
}
